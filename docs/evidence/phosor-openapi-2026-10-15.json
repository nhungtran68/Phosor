{"openapi":"3.1.0","info":{"title":"Phosor AI API","description":"AI video, image and speech generation API. Generate videos from text, images, audio or reference media, generate and edit images, bring your own LoRA models, and manage media assets.\n\n**Authentication:** Include your API key in the `X-API-Key` header.\n\n**Pricing:** Usage-based per model — see GET /api/v1/pricing/config for current rates.\n\n**Workflow:** Submit a task → poll status → retrieve result.\n\nFor more details visit [phosor.ai/docs](https://phosor.ai/docs).","contact":{"name":"Phosor AI","url":"https://phosor.ai/"},"license":{"name":"Proprietary"},"version":"0.2.0"},"paths":{"/api/v1/models":{"get":{"tags":["Models"],"summary":"List available models","description":"Return list of active external models.","operationId":"list_models_api_v1_models_get","responses":{"200":{"description":"List of available models","content":{"application/json":{"schema":{"properties":{"models":{"items":{"properties":{"id":{"type":"string","description":"Model identifier to use in inference/submit"},"name":{"type":"string"},"description":{"type":"string"},"type":{"type":"string","enum":["t2v","i2v"]}},"type":"object"},"type":"array"}},"type":"object"}}}}}}},"/api/v1/inference/submit":{"post":{"tags":["Inference"],"summary":"Submit video generation task","description":"Fal.ai compatible queue submit endpoint - supports LoRA parameters","operationId":"queue_submit_api_v1_inference_submit_post","requestBody":{"content":{"application/json":{"schema":{"properties":{"prompt":{"type":"string","description":"Text prompt describing the video to generate"},"model":{"type":"string","description":"Model ID (from /api/v1/models). Public MiniMax H3 FL2VA IDs: minimax/h3/text-to-video, minimax/h3/image-to-video. MiniMax H3 Ref2VA ID: minimax/h3/reference-to-video. FLUX.2-dev IDs: flux2/dev/text-to-image, flux2/dev/image-edit.","examples":["minimax/h3/text-to-video","minimax/h3/image-to-video","minimax/h3/reference-to-video","wan/v2.2-a14b/text-to-video","flux2/dev/text-to-image","flux2/dev/image-edit"]},"width":{"type":"integer","enum":[480,640,768,832,848,1024,1080,1280,1344,1920],"description":"Video width in pixels. Prefer resolution_tier + aspect_ratio for MiniMax H3.","default":832},"height":{"type":"integer","enum":[480,640,720,768,832,854,1024,1080,1280,1344,1920],"description":"Video height in pixels. Prefer resolution_tier + aspect_ratio for MiniMax H3.","default":480},"resolution_tier":{"type":"string","enum":["480p","512p","720p","768p","1080p"],"description":"Resolution tier. MiniMax H3 supports 480p and 768p; Wan models also support their own 512p/720p/1080p tiers."},"aspect_ratio":{"type":"string","enum":["16:9","4:3","1:1","3:4","9:16"],"description":"Aspect ratio. MiniMax H3 supports 16:9, 4:3, 1:1, 3:4, and 9:16."},"duration":{"type":"number","maximum":15.0,"minimum":4.0,"description":"Output duration in seconds. MiniMax H3 supports 4-15 seconds and is billed per output second.","default":5},"num_frames":{"type":"integer","description":"Number of frames for frame-based models. Wan auto-aligns to 1+4k. MiniMax H3 uses duration instead.","default":81},"frames_per_second":{"type":"integer","maximum":60.0,"minimum":4.0,"description":"Output FPS for Wan models. MiniMax H3 FPS is fixed at 24 and is not selectable.","default":16},"num_inference_steps":{"type":"integer","maximum":10.0,"minimum":4.0,"description":"Denoising steps (4-10). Lower=faster, higher=better quality"},"guidance_scale":{"type":"number","maximum":3.5,"minimum":1.0,"description":"Classifier-free guidance scale (1.0-3.5)"},"image_url":{"type":"string","description":"Image URL or S3 key for Image-to-Video (I2V) generation"},"end_image_url":{"type":"string","description":"Optional ending frame image URL or S3 key for MiniMax H3 image-to-video"},"lora_id":{"type":"string","format":"uuid","description":"LoRA model ID to apply (must be in 'ready' status)"},"lora_scale":{"type":"number","description":"LoRA influence strength","default":1.0},"seed":{"type":"integer","description":"Random seed for reproducibility"}},"type":"object","required":["prompt"]}}},"required":true},"responses":{"200":{"description":"Task queued successfully","content":{"application/json":{"schema":{"properties":{"request_id":{"type":"string","format":"uuid","description":"Use this ID to poll status and retrieve results"},"status":{"type":"string","enum":["queued"]},"message":{"type":"string"}},"type":"object"}}}},"400":{"description":"Invalid parameters (resolution, FPS, frames, etc.)","content":{"application/json":{"schema":{"properties":{"error":{"type":"string"},"message":{"type":"string"}},"type":"object"}}}},"401":{"description":"API key missing or invalid","content":{"application/json":{"schema":{"properties":{"error":{"type":"string"},"message":{"type":"string"}},"type":"object"}}}},"402":{"description":"Insufficient credits","content":{"application/json":{"schema":{"properties":{"error":{"type":"string"},"message":{"type":"string"}},"type":"object"}}}},"429":{"description":"Concurrency limit reached","content":{"application/json":{"schema":{"properties":{"error":{"type":"string"},"message":{"type":"string"}},"type":"object"}}}}}}},"/api/v1/inference/status/{request_id}":{"get":{"tags":["Inference"],"summary":"Get task status","description":"Get task status - Fal.ai compatible format. Only the owner of the task can query it.","operationId":"queue_status_api_v1_inference_status__request_id__get","parameters":[{"name":"request_id","in":"path","required":true,"schema":{"type":"string","title":"Request Id"}},{"name":"logs","in":"query","required":false,"schema":{"type":"boolean","default":true,"title":"Logs"}},{"name":"details","in":"query","required":false,"schema":{"type":"boolean","default":false,"title":"Details"}}],"responses":{"200":{"description":"Task status","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["queued","processing","completed","failed"]},"request_id":{"type":"string"},"queue_position":{"type":"integer","description":"Position in queue (0 = processing)"},"progress":{"type":"number","description":"Processing progress 0-100 (when processing)"},"logs":{"type":"array","items":{"type":"object","properties":{"message":{"type":"string"},"timestamp":{"type":"string","format":"date-time"}}}},"error":{"type":"string","description":"Error message (when failed)"},"result_url":{"type":"string","description":"Video URL (when completed)"},"details":{"type":"object","description":"Full job parameters (when details=true)"}}}}}},"404":{"description":"Task not found","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}}}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/inference/result/{request_id}":{"get":{"tags":["Inference"],"summary":"Get task result","description":"Get task result - Fal.ai compatible format\n\nRetrieve the final result of a completed task, including video URL.","operationId":"queue_result_api_v1_inference_result__request_id__get","parameters":[{"name":"request_id","in":"path","required":true,"schema":{"type":"string","title":"Request Id"}}],"responses":{"200":{"description":"Task result with video URL","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"video":{"type":"object","properties":{"url":{"type":"string","description":"Presigned S3 URL to download the video (expires in 2h)"}}},"seed":{"type":"integer"}}},"request_id":{"type":"string"}}}}}},"202":{"description":"Task still processing","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string"},"request_id":{"type":"string"},"status":{"type":"string","enum":["processing"]}}}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$