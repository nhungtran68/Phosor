":"integer"},"lora_id":{"type":"string"},"seed":{"type":"integer"},"credit_cost":{"type":"number"},"usd_cost":{"type":"number"},"request_id":{"type":"string"}}}}}},"404":{"description":"Request not found","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}}}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/inference/history":{"get":{"tags":["Inference"],"summary":"Get job history for user","description":"Get job history for the authenticated user.\n\nAccepts either X-API-Key header or Authorization: Bearer <session_token>.\nReturns the caller's jobs, newest first.","operationId":"queue_history_api_v1_inference_history_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}}],"responses":{"200":{"description":"User's job history","content":{"application/json":{"schema":{"type":"object","properties":{"jobs":{"type":"array","items":{"type":"object","properties":{"job_id":{"type":"string"},"status":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"credit_cost":{"type":"number"},"usd_cost":{"type":"number"}}}},"total":{"type":"integer"}}}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}}}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/inference/prompt/enhance":{"post":{"tags":["Inference"],"summary":"Enhance a video prompt","description":"Expand a short video prompt into a detailed shot description.\n\nRequires authentication. Returns text only: nothing is saved and no job is submitted,\nso you can review, edit or discard the result. If enhancement is unavailable, the\nresponse has `enhance